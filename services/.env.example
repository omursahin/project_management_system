# =============================================================================
# services/.env.example
#
# Iki servis (embedding_service + similarity_service) icin ORTAK ornek env.
# Kullanim: bu dosyayi `.env` olarak kopyalayin ve degerleri doldurun.
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows)
#
# docker-compose.yml icindeki "env_file: - ./.env" satirlarini acarsaniz
# bu degerler iki servise de gecer. Hepsi opsiyoneldir; varsayilanlar koddadir.
# =============================================================================

# -----------------------------------------------------------------------------
# DEPOLAMA (DB) AYARLARI  -- ortak
# -----------------------------------------------------------------------------
# STORAGE_BACKEND: "null" | "postgres"
#   null     -> HIC DB baglantisi kurulmaz. Servisler bagimsiz calisir (VARSAYILAN).
#   postgres -> postgres_store.py devreye girer, sonuclar DB'ye yazilir/okunur.
STORAGE_BACKEND=null

# DATABASE_DSN: SADECE STORAGE_BACKEND=postgres iken gereklidir.
# pgvector destekli bir Postgres'e isaret etmelidir (extension: vector).
# Ornek (docker ag icinde ana projenin db servisi):
# DATABASE_DSN=postgresql://postgres:postgres@db:5432/project_management
# Ornek (lokal):
# DATABASE_DSN=postgresql://postgres:postgres@localhost:5432/project_management

# -----------------------------------------------------------------------------
# PORTLAR  -- bilgi amacli (compose'ta sabittir: 8100 / 8200)
# -----------------------------------------------------------------------------
# EMBEDDING_PORT=8100
# SIMILARITY_PORT=8200

# -----------------------------------------------------------------------------
# EMBEDDING SERVICE -- model knob'lari
# -----------------------------------------------------------------------------
# Kullanilacak embedding modeli (varsayilan bge-m3).
# EMBEDDING_MODEL=BAAI/bge-m3

# HuggingFace model cache dizini (compose'ta /models'e mount'lanir).
# HF_HOME=/models

# Cikti vektor boyutu (bge-m3 dense -> 1024). Genelde degistirilmez.
# EMBEDDING_DIM=1024

# Cikti vektorlerini L2-normalize et (cosine = dot product olur).
# NORMALIZE_EMBEDDINGS=true

# Chunk'lama parametreleri (token bazli).
# CHUNK_SIZE=512
# CHUNK_OVERLAP=64
# MAX_TOKENS=8192

# Sparse (lexical) vektor uretimi. true ise chunk["sparse"] dolar.
# USE_SPARSE=false

# Model cihazi: cpu | cuda
# DEVICE=cpu

# -----------------------------------------------------------------------------
# SIMILARITY SERVICE -- karsilastirma knob'lari
# -----------------------------------------------------------------------------
# Eslesme esigi (cosine). Bu degerin uzerindeki eslesmeler "intihal" sayilir.
# SIMILARITY_THRESHOLD=0.80

# Skorlama: dense + sparse harmanlama agirligi (USE_SPARSE acikken anlamli).
# DENSE_WEIGHT=1.0
# SPARSE_WEIGHT=0.0

# Her hedef chunk icin tutulacak en iyi eslesme sayisi.
# TOP_K=3
