# ============================================================
# Similarity Service ornek ortam dosyasi
# Kullanim: bu dosyayi ".env" olarak kopyalayip degerleri duzenleyin.
# ============================================================

# --- Skorlama ---
# Tek skora indirme yontemi: coverage | maxsim | topk
SCORING_METHOD=coverage
# coverage yonteminde bir hedef chunk'in "eslesmis" sayilmasi icin esik (0..1)
SIM_THRESHOLD=0.85
# topk yonteminde ortalamasi alinacak en yuksek benzerlik sayisi
TOP_K=10

# --- Kapsam (SADECE DB/postgres modunda anlamli) ---
# Adaylarin secilecegi kume: all | same_report | same_term_lesson
SCOPE=same_report

# --- Hibrit agirliklar (sparse opsiyonel) ---
# Sparse kapaliyken SPARSE_WEIGHT=0.0 birakin.
HYBRID_DENSE_WEIGHT=1.0
HYBRID_SPARSE_WEIGHT=0.0

# --- Depolama (DB) ---
# null      -> hic DB baglantisi kurulmaz; servis sadece request body ile calisir (VARSAYILAN)
# postgres  -> psycopg + pgvector ile DB'den okur/yazar
STORAGE_BACKEND=null
# Sadece postgres modunda gerekir, ornek:
# DATABASE_DSN=postgresql://user:pass@localhost:5432/pms
DATABASE_DSN=

# --- Sunucu ---
SERVICE_PORT=8200
