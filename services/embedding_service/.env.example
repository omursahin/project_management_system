# Embedding Service ornek ortam degiskenleri.
# Bu dosyayi .env olarak kopyalayip degerleri ihtiyaca gore degistirin.

# --- Model ---
# MODEL_NAME=BAAI/bge-m3
# DEVICE=cpu              # cpu | cuda
# USE_FP16=false          # Sadece GPU'da anlamli
# BATCH_SIZE=12

# --- Chunking ---
# CHUNK_SIZE=512
# CHUNK_OVERLAP=64
# CHUNK_STRATEGY=paragraph   # paragraph | fixed

# --- Embedding davranisi ---
# USE_SPARSE=false
# NORMALIZE=true

# --- Token sayimi ---
# TOKENIZER_MODE=hf          # hf | heuristic

# --- Depolama ---
# Varsayilan "null": HIC DB baglantisi kurulmaz, servis bagimsiz calisir.
STORAGE_BACKEND=null
# DB'yi aktiflestirmek icin:
# STORAGE_BACKEND=postgres
# DATABASE_DSN=postgresql://user:password@localhost:5432/project_management

# --- Servis ---
# SERVICE_PORT=8100
